{
    "version": "0.2.0",
    "configurations": [
		{
            "name": "Debug Vue (Laravel+Vite)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8000", // رابط Laravel الخاص بك
            "webRoot": "${workspaceFolder}",
            "pathMapping": {
                "/resources/js": "${workspaceFolder}/resources/js"
            },
            "sourceMapPathOverrides": {
                "vite://root/*": "${workspaceFolder}/*"
            }
        },
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003
        }
    ]
}
